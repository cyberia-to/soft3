#!/usr/bin/env bash
# soft3-chain-check — health of one soft3 root-chain instance on this machine.
#
#   soft3-chain-check pussy            # full check, one line per probe, exit 0 ok / 1 degraded / 2 down
#   soft3-chain-check --pre pussy      # ExecStartPre gate: clock synchronized, disk, env sanity (no HTTP)
#   soft3-chain-check --json pussy     # same checks, one JSON object on stdout
#
# Environment (read from the process environment, before the env file is sourced):
#   SOFT3_ETC    dir of <chain>.env and <chain>.peers.toml   (default /etc/soft3)
#   SOFT3_STATE  state root, <chain> lives under it           (default /var/lib/soft3)
#   SOFT3_PIDFILE (set in the env file, agent-a) pidfile of a supervised node; without it the systemd unit is checked
#
# Install: sudo install -m 0755 soft3-chain-check /usr/local/bin/
# Cron:    */5 * * * * cyber /usr/local/bin/soft3-chain-check pussy >> /var/log/soft3-chain/check-pussy.log 2>&1
#
# What "healthy" means here (assumptions from the spec in progress, specs/chain.md — see README.md):
#   /health answers 200 within 2 s           the process accepts connections
#   /status answers 200 within 10 s          the state lock is not convoyed (cyb bodies poll it every 15 s with a 10 s timeout)
#   height advanced within SOFT3_STALE_SECS  the chain is producing or receiving blocks
#   radio UDP port is bound                  the node is reachable for peers
#   peers file parses like the node does    read with python3 tomllib (as the node's toml parser does; awk fallback = DEGRADED at best). DOWN: not valid TOML, wrong types, missing file, version != 1, other chain, peer without id, bad id, id not an ed25519 point, no parsable address; DEGRADED: empty-id skipped, unparsable addr dropped
#   clock NTP-synchronized                   PoW timestamp rules need it
#   free disk >= SOFT3_MIN_DISK_GIB          the log/bbg can grow
#   threads < 512                            the 2026-10-15 convoy signature (1,800 threads) is caught early
set -uo pipefail

mode=full
case "${1:-}" in
  --pre)  mode=pre;  shift ;;
  --json) mode=json; shift ;;
esac
chain="${1:-}"
[[ -n "$chain" ]] || { echo "usage: soft3-chain-check [--pre|--json] <chain>" >&2; exit 2; }

etc_dir="${SOFT3_ETC:-/etc/soft3}"
state_root="${SOFT3_STATE:-/var/lib/soft3}"
env_file="$etc_dir/$chain.env"
[[ -r "$env_file" ]] || { echo "DOWN env: missing $env_file"; exit 2; }
# shellcheck disable=SC1090
source "$env_file"
: "${SOFT3_CHAIN:?SOFT3_CHAIN unset in $env_file}"
: "${SOFT3_BIND:?SOFT3_BIND unset}"
: "${SOFT3_RADIO:?SOFT3_RADIO unset}"
stale_secs="${SOFT3_STALE_SECS:-600}"
min_disk_gib="${SOFT3_MIN_DISK_GIB:-5}"
home="$state_root/$chain"
unit="soft3-chain@$chain"
radio_port="${SOFT3_RADIO##*:}"
worst=0
declare -a lines

say() { # level name detail
  local level="$1" name="$2" detail="$3"
  lines+=("$level $name: $detail")
  case "$level" in DEGRADED) (( worst < 1 )) && worst=1 ;; DOWN) worst=2 ;; esac
}

# --- machine-level checks (also the ExecStartPre gate) ---------------------------------------
if [[ "$(timedatectl show -p NTPSynchronized --value 2>/dev/null)" == "yes" ]]; then
  say OK clock "NTP synchronized ($(timedatectl timesync-status 2>/dev/null | awk -F': *' '/Offset/{print $2}' | head -1))"
elif timedatectl show -p NTPSynchronized --value >/dev/null 2>&1; then
  say DOWN clock "system clock NOT NTP-synchronized — PoW timestamps would be rejected"
else
  # no systemd (container): ask the kernel. adjtimex returns 5 (TIME_ERROR) when the clock is unsynchronized.
  adj=$(python3 -I -c '
import ctypes, ctypes.util, sys
libc = ctypes.CDLL(ctypes.util.find_library("c") or "libc.so.6", use_errno=True)
class Timex(ctypes.Structure):
    _fields_ = [("modes", ctypes.c_uint), ("offset", ctypes.c_long), ("freq", ctypes.c_long),
                ("maxerror", ctypes.c_long), ("esterror", ctypes.c_long), ("status", ctypes.c_int),
                ("pad", ctypes.c_char * 256)]
t = Timex()
r = libc.adjtimex(ctypes.byref(t))
if r < 0:
    sys.exit(1)
print(r, t.offset, t.maxerror)
' 2>/dev/null) || adj=""
  if [[ -n "$adj" ]]; then
    read -r adj_state adj_off adj_max <<< "$adj"
    if [[ "$adj_state" == 5 ]]; then
      say DOWN clock "kernel clock unsynchronized (adjtimex TIME_ERROR) — PoW timestamps would be rejected"
    else
      say OK clock "kernel clock synchronized (adjtimex state=$adj_state offset=${adj_off} us maxerror=${adj_max} us)"
    fi
  else
    say DEGRADED clock "clock sync state unknown (no timedatectl, adjtimex unavailable)"
  fi
fi

if [[ -d "$home" ]]; then
  free_gib=$(df -BG --output=avail "$home" 2>/dev/null | tail -1 | tr -dc '0-9')
  if (( ${free_gib:-0} >= min_disk_gib )); then say OK disk "${free_gib} GiB free on $home"
  else say DEGRADED disk "${free_gib:-?} GiB free on $home (< ${min_disk_gib})"; fi
else
  say DEGRADED disk "$home does not exist yet"
fi

if [[ "$SOFT3_CHAIN" != "$chain" ]]; then
  say DOWN env "SOFT3_CHAIN='$SOFT3_CHAIN' but instance is '$chain'"
else
  say OK env "chain=$chain bind=$SOFT3_BIND radio=$SOFT3_RADIO"
fi
peers="$etc_dir/$chain.peers.toml"
if [[ -r "$peers" ]]; then
  # Both launchers always pass --peers, and the node reads it at startup (crate/src/node/chain_node.rs),
  # so a missing file stops the node (DOWN below). Mirrors parse_peers (crate/src/chain/net/discovery.rs);
  # Primary path: ONE python3 program (tomllib, Python >= 3.11) does the whole job like the node: the file must be
  # valid TOML 1.0 (the toml crate; multi-line arrays, inline tables, literal strings, dotted keys all work), then the
  # serde types of PeersFile/PeerEntry (version u32, chain str, peer array of tables, id required, name/id/relay str,
  # addrs array of str; unknown keys ignored), then parse_peers' own checks in its order: version, chain, then the
  # FIRST refusing peer in file order. Any failure before that is DOWN. Without python3 + tomllib the awk below reads
  # the file line by line and cannot see multi-line arrays or inline tables, so its OK is reported as DEGRADED.
  # Rules the python program and the awk share (comment continues):
  # the node refuses the whole file (DOWN) for: a top-level version other than 1 (or none), a top-level
  # chain other than this instance's (the env probe holds instance = SOFT3_CHAIN = the genesis name), a [[peer]] without an id key (serde), a non-empty id
  # that is not 64 hex chars (optional 0x prefix), a 64-hex id that is not an ed25519 point
  # (EndpointId::from_bytes -> curve25519-dalek 5.0.0-pre.1 decompress, ZIP-215: bit 255 ignored, y taken mod p,
  # x = 0 with the sign bit set accepted, no small-order check; accepted iff (y^2-1)/(d*y^2+1) is a square mod p;
  # checked by the python3 below, DEGRADED when python3 is missing), or a peer none of whose addrs parse as a SocketAddr.
  # It skips a peer with id = "" (DEGRADED) and silently drops unparsable addrs of a usable peer
  # (DEGRADED here, so operators see it). SocketAddr is approximated: IPv4 a.b.c.d:port exactly
  # (octets 0-255, no leading zeros); IPv6 [..]:port or [..%digits]:port when the brackets hold only
  # hex digits, ':' and '.' with at least one ':'; port 0-65535. Hostnames never parse.
  peers_py=
  IFS= read -r -d '' peers_py <<'PYEOF' || true
import re, sys, tomllib
path, want = sys.argv[1], sys.argv[2]

def out(level, msg):
    print(level + "\t" + re.sub(r"[\t\r\n]", " ", msg))
    sys.exit(0)

def down(msg):
    out("DOWN", msg + " — the node refuses " + path)

# --- the TOML document (toml 0.8 = TOML 1.0) and the serde types of PeersFile / PeerEntry ---
try:
    with open(path, "rb") as f:
        doc = tomllib.load(f)
except (tomllib.TOMLDecodeError, UnicodeDecodeError) as e:
    down("not valid TOML: %s" % e)

def isint(v):
    return isinstance(v, int) and not isinstance(v, bool)

if "version" not in doc:
    down("version missing")
if not isint(doc["version"]) or not 0 <= doc["version"] <= 2**32 - 1:
    down("version is not a u32 integer")
if "chain" not in doc:
    down("chain missing")
if not isinstance(doc["chain"], str):
    down("chain is not a string")
peers = doc.get("peer", [])
if not isinstance(peers, list) or not all(isinstance(p, dict) for p in peers):
    down("peer is not an array of tables")
for p in peers:
    nm = p.get("name", "")
    if not isinstance(nm, str):
        down("peer name is not a string")
    if "id" not in p:
        down("peer '%s': missing field id" % nm)
    if not isinstance(p["id"], str):
        down("peer '%s': id is not a string" % nm)
    if "relay" in p and not isinstance(p["relay"], str):
        down("peer '%s': relay is not a string" % nm)
    if "addrs" in p and not (isinstance(p["addrs"], list) and all(isinstance(a, str) for a in p["addrs"])):
        down("peer '%s': addrs is not an array of strings" % nm)

# --- then parse_peers' own checks, in its order ---
if doc["version"] != 1:
    down("version is %d, not 1" % doc["version"])
if doc["chain"] != want:
    down("chain is '%s', this instance runs '%s'" % (doc["chain"], want))

# SocketAddr approximation: exactly what the awk fallback accepts (verified against the binary).
def okport(p):
    return re.fullmatch("[0-9]+", p) is not None and int(p) <= 65535

def okv4(h):
    o = h.split(".")
    if len(o) != 4:
        return False
    return all(re.fullmatch("[0-9]{1,3}", x) and (len(x) == 1 or x[0] != "0") and int(x) <= 255 for x in o)

def okaddr(a):
    if a.startswith("["):
        i = a.find("]:")
        if i < 0:
            return False
        h, p = a[1:i], a[i + 2:]
        h = re.sub(r"%[0-9]+$", "", h)
        return re.fullmatch(r"[0-9a-fA-F:.]+", h) is not None and ":" in h and okport(p)
    i = a.rfind(":")
    if i < 0:
        return False
    return okport(a[i + 1:]) and okv4(a[:i])

# ed25519 point check (EndpointId::from_bytes: ZIP-215 decompress, see the shell comment)
P = 2**255 - 19
D = -121665 * pow(121666, P - 2, P) % P

def ispoint(h):
    y = (int.from_bytes(bytes.fromhex(h), "little") & (2**255 - 1)) % P
    u = (y * y - 1) % P
    v = (D * y * y + 1) % P
    return not (u and (not v or pow(u * pow(v, P - 2, P) % P, (P - 1) // 2, P) != 1))

skipped, dropped, usable = [], [], 0
for p in peers:
    nm, pid = p.get("name", ""), p["id"]
    if pid == "":
        skipped.append(nm)
        continue
    if not re.fullmatch(r"(0x)?[0-9a-fA-F]{64}", pid):
        down("peer '%s': id is not 64 hex chars" % nm)
    if not ispoint(pid[2:] if pid[:2] == "0x" else pid):
        down("peer '%s': id is not an ed25519 point" % nm)
    addrs = p.get("addrs", [])
    bad = [a for a in addrs if not okaddr(a)]
    if len(bad) == len(addrs):
        down("peer '%s': no parsable address" % nm)
    usable += 1
    if bad:
        dropped.append(nm + " " + " ".join('"%s"' % a for a in bad))

if not peers:
    out("DEGRADED", "no bootstrap peer in " + path)
if skipped or dropped or usable == 0:
    why = ""
    if skipped or not dropped:
        why = "; skipped (empty id): " + ", ".join(skipped)
    if dropped:
        why += "; dropped (unparsable address): " + ", ".join(dropped)
    out("DEGRADED", "%d usable of %d bootstrap peers in %s%s" % (usable, len(peers), path, why))
out("OK", "%d bootstrap peers in %s" % (usable, path))
PYEOF
  peers_done=0
  if python3 -I -c 'import tomllib' >/dev/null 2>&1; then
    peers_out=$(python3 -I -c "$peers_py" "$peers" "$chain" 2>/dev/null)
    if [[ -n "$peers_out" ]]; then
      IFS=$'\t' read -r peers_level peers_msg <<< "$peers_out"
      say "$peers_level" peers "$peers_msg"
    else
      say DEGRADED peers "the tomllib probe failed to run on $peers"
    fi
    peers_done=1
  fi
  # Fallback: awk, line by line (no python3 with tomllib).
  if (( ! peers_done )); then
  # awk prints: N, U, then version, chain, missing-id, bad-id, no-addr, skipped and dropped lines.
  peer_report=$(awk '
    function quoted(s) { return match(s, /"[^"]*"/) ? substr(s, RSTART + 1, RLENGTH - 2) : "" }
    function okport(p) { sub(/^0+/, "", p); return p ~ /^[0-9]*$/ && length(p) <= 5 && p + 0 <= 65535 }
    function okv4(h,   o, i) {
      if (split(h, o, ".") != 4) return 0
      for (i = 1; i <= 4; i++) {
        if (o[i] !~ /^[0-9]+$/ || length(o[i]) > 3 || (length(o[i]) > 1 && o[i] ~ /^0/) || o[i] + 0 > 255) return 0 }
      return 1 }
    function okaddr(a,   i, h, p) {
      if (a ~ /^\[/) {
        i = index(a, "]:"); if (!i) return 0
        h = substr(a, 2, i - 2); p = substr(a, i + 2)
        sub(/%[0-9]+$/, "", h)
        return h ~ /^[0-9a-fA-F:.]+$/ && index(h, ":") && okport(p) && p != "" }
      i = length(a); while (i > 0 && substr(a, i, 1) != ":") i--
      if (i == 0) return 0
      p = substr(a, i + 1)
      return p != "" && okport(p) && okv4(substr(a, 1, i - 1)) }
    function flush(   id) {
      if (!inpeer) return
      n++
      id = pid
      if (!hasid) { if (missid == "") missid = "peer \047" pname "\047: missing field id"; return }
      if (id == "") { skipped = skipped (skipped == "" ? "" : ", ") pname; return }
      if (id !~ /^(0x)?[0-9a-fA-F]+$/ || length(id) - (id ~ /^0x/ ? 2 : 0) != 64) {
        if (bad == "") bad = "peer \047" pname "\047: id is not 64 hex chars"; return }
      ids = ids id "\t" pname "\n"
      if (pn == 0) { if (noaddr == "") noaddr = "peer \047" pname "\047: no parsable address"; return }
      u++
      if (pdrop != "") dropped = dropped (dropped == "" ? "" : ", ") pname " " pdrop
    }
    !seenhdr && /^[ \t]*version[ \t]*=/ {
      s = $0; sub(/^[^=]*=[ \t]*/, "", s); sub(/[ \t]*(#.*)?$/, "", s); ver = s; hasver = 1; next }
    !seenhdr && /^[ \t]*chain[ \t]*=/ { fchain = quoted($0); haschain = 1; next }
    /^[ \t]*\[\[peer\]\]/ { flush(); seenhdr = 1; inpeer = 1; pname = ""; pid = ""; hasid = 0; pn = 0; pdrop = ""; next }
    /^[ \t]*\[/ { flush(); seenhdr = 1; inpeer = 0; next }
    inpeer && /^[ \t]*name[ \t]*=/ { pname = quoted($0); next }
    inpeer && /^[ \t]*id[ \t]*=/ { pid = quoted($0); hasid = 1; next }
    inpeer && /^[ \t]*addrs[ \t]*=/ {
      s = $0; sub(/^[^=]*=/, "", s)
      while (match(s, /"[^"]*"/)) {
        a = substr(s, RSTART + 1, RLENGTH - 2)
        if (okaddr(a)) pn++; else pdrop = pdrop (pdrop == "" ? "" : " ") "\"" a "\""
        s = substr(s, RSTART + RLENGTH) }
      next }
    END {
      flush()
      vmsg = !hasver ? "version missing" : (ver != "1" ? "version is " ver ", not 1" : "")
      cmsg = !haschain ? "chain missing" : (fchain != want ? "chain is \047" fchain "\047, this instance runs \047" want "\047" : "")
      print n + 0; print u + 0; print vmsg; print cmsg; print missid; print bad; print noaddr; print skipped; print dropped; printf "%s", ids }
  ' want="$chain" "$peers")
  { read -r p_n; read -r p_u; read -r p_ver; read -r p_chain; read -r p_missid; read -r p_bad; read -r p_noaddr; read -r p_skipped; read -r p_dropped; read -r -d '' p_ids; } <<< "$peer_report"
  # Is every well-formed id an ed25519 point? prints the name of the first peer whose id is not (rc 1).
  p_nopoint=""; p_nopy=0
  if [[ -n "$p_ids" && -z "$p_ver$p_chain$p_missid$p_bad" ]]; then
    if command -v python3 >/dev/null 2>&1; then
      p_nopoint=$(printf '%s\n' "$p_ids" | python3 -I -c '
import sys
P = 2**255 - 19
D = -121665 * pow(121666, P - 2, P) % P
for line in sys.stdin:
    line = line.rstrip("\n")
    if not line:
        continue
    pid, name = (line.split("\t", 1) + [""])[:2]
    h = pid[2:] if pid[:2] == "0x" else pid
    y = (int.from_bytes(bytes.fromhex(h), "little") & (2**255 - 1)) % P
    u = (y * y - 1) % P
    v = (D * y * y + 1) % P
    if u and (not v or pow(u * pow(v, P - 2, P) % P, (P - 1) // 2, P) != 1):
        print(name)
        sys.exit(1)
' 2>/dev/null); rc=$?
      (( rc == 0 || rc == 1 )) || { p_nopy=1; p_nopoint=""; }
      (( rc == 1 )) && p_nopoint="${p_nopoint:-?}"
    else
      p_nopy=1
    fi
  fi
  if [[ -n "$p_ver" ]]; then
    say DOWN peers "$p_ver — the node refuses $peers"
  elif [[ -n "$p_chain" ]]; then
    say DOWN peers "$p_chain — the node refuses $peers"
  elif [[ -n "$p_missid" ]]; then
    say DOWN peers "$p_missid — the node refuses $peers"
  elif [[ -n "$p_bad" ]]; then
    say DOWN peers "$p_bad — the node refuses $peers"
  elif [[ -n "$p_nopoint" ]]; then
    say DOWN peers "peer '$p_nopoint': id is not an ed25519 point — the node refuses $peers"
  elif [[ -n "$p_noaddr" ]]; then
    say DOWN peers "$p_noaddr — the node refuses $peers"
  elif (( p_n == 0 )); then
    say DEGRADED peers "no bootstrap peer in $peers"
  elif [[ -n "$p_skipped" || -n "$p_dropped" || p_u -eq 0 ]]; then
    p_why=""
    [[ -n "$p_skipped" || -z "$p_dropped" ]] && p_why="; skipped (empty id): $p_skipped"
    [[ -n "$p_dropped" ]] && p_why+="; dropped (unparsable address): $p_dropped"
    say DEGRADED peers "$p_u usable of $p_n bootstrap peers in $peers$p_why"
  elif (( p_nopy )); then
    say DEGRADED peers "cannot check id is a curve point (no python3; TOML read line by line: no python3 with tomllib)"
  else
    say DEGRADED peers "$p_u bootstrap peers in $peers (TOML read line by line: no python3 with tomllib)"
  fi
  fi
else
  say DOWN peers "$peers missing or unreadable — the node is started with --peers and refuses to start"
fi

if [[ "$mode" == pre ]]; then
  printf '%s\n' "${lines[@]}"
  (( worst == 2 )) && exit 1 || exit 0
fi

# --- process-level checks ------------------------------------------------------------------------
if [[ -n "${SOFT3_PIDFILE:-}" ]]; then
  pid=$(cat "$SOFT3_PIDFILE" 2>/dev/null || true)
  if [[ "$pid" =~ ^[0-9]+$ ]] && kill -0 "$pid" 2>/dev/null; then
    threads=$(ls "/proc/$pid/task" 2>/dev/null | wc -l | tr -d ' ')
    if (( threads < 512 )); then say OK unit "pid $pid alive threads=$threads ($SOFT3_PIDFILE)"
    else say DEGRADED unit "pid $pid has $threads threads — request convoy?"; fi
  else
    say DOWN unit "no live process for pidfile $SOFT3_PIDFILE"
  fi
elif systemctl is-active --quiet "$unit"; then
  pid=$(systemctl show -p MainPID --value "$unit")
  threads=$(ls "/proc/$pid/task" 2>/dev/null | wc -l | tr -d ' ')
  if (( threads < 512 )); then say OK unit "$unit active pid=$pid threads=$threads"
  else say DEGRADED unit "$unit pid=$pid has $threads threads — request convoy?"; fi
else
  say DOWN unit "$unit is not active"
fi

udp_bound() { # port -> 0 when a UDP socket listens on it
  if command -v ss >/dev/null 2>&1; then
    ss -uln 2>/dev/null | awk '{print $5}' | grep -qE "[:.]$1$"
  else
    local hex
    hex=$(printf '%04X' "$1")
    cat /proc/net/udp /proc/net/udp6 2>/dev/null | awk '{print $2}' | grep -qE ":$hex$"
  fi
}
if udp_bound "$radio_port"; then
  say OK radio "udp/$radio_port bound"
else
  say DOWN radio "nothing bound on udp/$radio_port"
fi

code=$(curl -s -m 2 -o /dev/null -w '%{http_code}' "http://$SOFT3_BIND/health" || true)
if [[ "$code" == 200 ]]; then say OK health "200"
else say DOWN health "http $code (2 s budget)"; fi

status_out=$(mktemp); trap 'rm -f "$status_out"' EXIT
t0=$(date +%s.%N)
code=$(curl -s -m 10 -o "$status_out" -w '%{http_code}' "http://$SOFT3_BIND/status" || true)
t1=$(date +%s.%N)
elapsed=$(awk -v a="$t0" -v b="$t1" 'BEGIN{printf "%.2f", b-a}')
height=""; root=""
if [[ "$code" == 200 ]]; then
  # accept either the cybermark text form (`height 41248`) or JSON (`"height": 41248`)
  height=$(grep -oE '"?height"?[ :=]+[0-9]+' "$status_out" | grep -oE '[0-9]+$' | head -1)
  root=$(grep -oE '"?(bbg[-_])?root"?[ :=]+"?[0-9a-f]{8,}' "$status_out" | grep -oE '[0-9a-f]{8,}$' | head -1)
  say OK status "200 in ${elapsed}s height=${height:-?} root=${root:0:12}"
else
  say DOWN status "http $code after ${elapsed}s (10 s budget)"
fi

# block progress, remembered between runs in the state dir
mark="$home/.check-height"
now=$(date +%s)
if [[ -n "$height" ]]; then
  if [[ -r "$mark" ]]; then
    read -r last_h last_t < "$mark"
    if (( height > last_h )); then
      say OK progress "height $last_h -> $height"
      echo "$height $now" > "$mark"
    elif (( now - last_t > stale_secs )); then
      say DEGRADED progress "height $height unchanged for $(( now - last_t )) s (> $stale_secs)"
    else
      say OK progress "height $height unchanged for $(( now - last_t )) s"
    fi
  else
    echo "$height $now" > "$mark" 2>/dev/null && say OK progress "first sample height=$height"
  fi
fi

if [[ "$mode" == json ]]; then
  printf '{"chain":"%s","exit":%d,"checks":[' "$chain" "$worst"
  sep=""
  for l in "${lines[@]}"; do
    lvl="${l%% *}"; rest="${l#* }"; name="${rest%%:*}"; detail="${rest#*: }"
    printf '%s{"level":"%s","name":"%s","detail":"%s"}' "$sep" "$lvl" "$name" "${detail//\"/\\\"}"
    sep=","
  done
  printf ']}\n'
else
  printf '%s %s\n' "$(date -u +%FT%TZ)" "$chain"
  printf '  %s\n' "${lines[@]}"
fi
exit "$worst"
