# $CHAIN_ROOT/etc/<chain>.env on agent-a (default /srv/forge/claude/chain/etc/pussy-rc.env).
# Sourced by run-node.sh and soft3-chain-check. No secrets; the radio key is generated in the state dir.

# chain id: pussy | bostrom | pussy-rc (rehearsal)
SOFT3_CHAIN=pussy-rc

# HTTP API, loopback only — agent-a publishes nothing. pussy-rc 7783 · pussy 7781 · bostrom 7782
SOFT3_BIND=127.0.0.1:7783

# radio listen port. agent-a is behind NAT, inbound is not assumed; it dials out to cyberproxy.
# pussy-rc 7793/udp · pussy 7791/udp · bostrom 7792/udp
SOFT3_RADIO=0.0.0.0:7793

SOFT3_MONIKER=agent-a-pussy-rc

# pidfile of the supervised node (soft3-chain-check uses it instead of systemctl)
SOFT3_PIDFILE=/srv/forge/claude/chain/run/pussy-rc.pid

# optional: pass --log-net to the node (1 = yes)
SOFT3_LOG_NET=

# health-check thresholds (soft3-chain-check)
SOFT3_STALE_SECS=600
SOFT3_MIN_DISK_GIB=20

# CPU miner (soft3 mine --backend cpu), supervised next to the node. Empty address = no miner.
# neuron id, 64 hex; the coinbase goes to it
SOFT3_MINE_ADDRESS=
# cpu threads; empty = every core (12 here). Leave a few for the node: 8 is a sane start
SOFT3_MINE_THREADS=
# pidfile of the miner
SOFT3_MINE_PIDFILE=/srv/forge/claude/chain/run/pussy-rc.mine.pid
