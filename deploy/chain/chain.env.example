# /etc/soft3/<chain>.env — parameters of one soft3 root-chain instance.
# Copy to /etc/soft3/pussy.env or /etc/soft3/bostrom.env, chmod 0640 root:cyber.
# No secrets live here; the radio identity key is generated by the node in its home.

# chain id, one of the launch set accepted by genesis validation: pussy | bostrom
SOFT3_CHAIN=pussy

# HTTP API bind — loopback only; nginx publishes it (nginx-chain-api.conf.template)
# convention: spacepussy-test 7780 · pussy 7781 · bostrom 7782
SOFT3_BIND=127.0.0.1:7781

# radio (QUIC/UDP) listen port — must match the ufw rule (ufw-chain.sh) and the peers files of the other nodes
# convention: pussy 7791/udp · bostrom 7792/udp
SOFT3_RADIO=0.0.0.0:7791

# how this node names itself in /status and in gossip
SOFT3_MONIKER=cyberproxy-pussy

# health-check thresholds (read by soft3-chain-check)
# seconds without a new block before the check reports STALE — set from the block cadence in specs/chain.md
SOFT3_STALE_SECS=600
# minimum free disk on the state directory, GiB
SOFT3_MIN_DISK_GIB=5
