# /etc/systemd/system/soft3-chain@<chain>.service.d/limits.conf — per-machine resource limits.
# cyberproxy (7.7 GB total, frappe + the 0.10.0 node already use ~5 GB): MemoryMax=2G
# agent-a has no systemd (container, PID 1 is sshd): there is no drop-in. Its limits are
# `ulimit -n 65536` in agent-a/run-node.sh (and `prlimit` if a hard cap is wanted); 47 GB RAM, no MemoryMax.
# (deimos and jupiter are retired, 2026-10-31.)
# Apply: sudo mkdir -p /etc/systemd/system/soft3-chain@pussy.service.d && sudo cp limits.conf.example \
#        /etc/systemd/system/soft3-chain@pussy.service.d/limits.conf && sudo systemctl daemon-reload
[Service]
MemoryMax=2G
MemoryHigh=1536M
