# /etc/logrotate.d/soft3-chain — files written by the health check and the ufw helper.
# The node itself logs to journald (see journald-soft3-chain.conf); nothing of it is rotated here.
/var/log/soft3-chain/*.log {
    daily
    rotate 30
    missingok
    notifempty
    compress
    delaycompress
    create 0640 cyber adm
}
