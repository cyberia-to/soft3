# /etc/soft3/<chain>.mine.env — the miner beside a chain node (soft3-mine@<chain>.service).
# The node does not mine; `soft3 mine` asks GET /template and POSTs /submit (chain-wire §7).
# chmod 0640 root:cyber. No secret here: the address only receives the coinbase.

# the local node's HTTP bind (SOFT3_BIND of /etc/soft3/<chain>.env); pussy-rc has no built-in default
SOFT3_MINE_NODE=http://127.0.0.1:7781

# neuron (64 hex) the coinbase pays; matures after 100 blocks (chain.md §2.2)
SOFT3_MINE_ADDRESS=

# cpu | webgpu (Vulkan; deimos/jupiter GTX 1080 measured 3.21 MH/s) | auto
SOFT3_MINE_BACKEND=cpu

# cpu threads; i7-7700 measured 66 kH/s per thread (x86-64 baseline build), Skylake vCPU 42 kH/s
SOFT3_MINE_THREADS=2
